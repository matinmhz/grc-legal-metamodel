{
  "name": "GRC Legal Metamodel (Python 3.12)",
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  "remoteUser": "vscode",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Legal metamodel viewer", "onAutoForward": "notify" }
  },
  "postCreateCommand": "python -m pip install --no-deps --no-build-isolation -e .",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "redhat.vscode-yaml"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  }
}
